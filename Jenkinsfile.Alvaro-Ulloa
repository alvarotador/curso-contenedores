pipeline {
    agent {
        kubernetes {
            yamlFile 'agent.yaml'
            defaultContainer 'k8s-node'
        }
    }
    environment {
        APP_VERSION = '3.0.0'
        IMAGE_NAME = 'alvarotador/tarea-final'
        IMAGE_TAG = 'alvaro-ulloa'
        NAMESPACE = 'ns-alvaro-ulloa'
    }
    stages {
        stage('install') {
            steps {
                container('k8s-node') {
                    sh 'corepack enable'
                    sh 'npm install'
                }
            }
        }
        stage('test') {
            steps {
                container('k8s-node') {
                    sh 'npm run test || true'
                }
            }
        }
        stage('build') {
            steps {
                container('docker') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:${APP_VERSION}"
                }
            }
        }
        stage('push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    ),
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_PASS'
                    )
                ]) {
                    container('docker') {
                        // 1. Push a Docker Hub
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                        sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker push ${IMAGE_NAME}:${APP_VERSION}"

                        // 2. Push a GitHub Container Registry (GHCR)
                        sh "echo \$GH_PASS | docker login ghcr.io -u \$GH_USER --password-stdin"
                        sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ghcr.io/alvarotador/tarea-final:${IMAGE_TAG}"
                        sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ghcr.io/alvarotador/tarea-final:${APP_VERSION}"
                        sh "docker push ghcr.io/alvarotador/tarea-final:${IMAGE_TAG}"
                        sh "docker push ghcr.io/alvarotador/tarea-final:${APP_VERSION}"
                    }
                }
            }
        }
        stage('deploy') {
            steps {
                container('k8s-node') {
                    sh '''
                        apk add --no-cache curl
                        curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                        kubectl apply -f entrega.yaml
                    '''
                }
            }
        }
    }
}
